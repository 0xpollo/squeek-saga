# Squeek Saga configuration. Copy to .env and fill in. Never commit .env.
# There is no private key here and there never will be: the bot only reads the chain.

# --- Public site ---------------------------------------------------------------
# Domain served by Caddy (no scheme), and the full public URL used in links.
SITE_DOMAIN=saga.example.com
SITE_URL=https://saga.example.com
# Host port the app is published on (127.0.0.1 only).
HOST_PORT=8000

# --- Discord ---------------------------------------------------------------------
# From https://discord.com/developers/applications -> your app -> Bot -> Token
DISCORD_TOKEN=
# Application ID (General Information). Used to build the "Add to Discord" link.
DISCORD_CLIENT_ID=

# --- Storyteller (Claude API) ---------------------------------------------------
# One call per chapter, at most one chapter per hour. Without a key the saga
# still runs, using built-in stock chapters.
ANTHROPIC_API_KEY=
SAGA_MODEL=claude-opus-5-5

# --- Chain access (read-only) ------------------------------------------------------
# Any Ethereum Sepolia JSON-RPC endpoint. The default public node keeps about
# 33 hours of history, which is enough; a provider endpoint is more reliable.
RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# Blocks behind the tip at which everything is read (the public API also uses 12).
CONFIRMATIONS=12
# How far back settlement logs are fetched after a restart (must be within the RPC's history).
LOG_LOOKBACK_BLOCKS=3000

# --- Game tuning (optional) ----------------------------------------------------------
# Settled work units per hour at or above which the hour counts as a sprint.
SPRINT_WORK_PER_HOUR=1400
# After an outage, at most this many hours are told in one catch-up chapter.
MAX_CATCHUP_HOURS=6
# Boss hit points = this % of the work settled over the previous 1008 certified rounds.
RAID_HP_PERCENT=90
RAID_DEFAULT_HP=45000
RAID_MIN_HP=10000

# --- Squeekchain Genesis verification (home page <head>) --------------------------
# Paste the values Squeekchain gives you. Rendered only on the home page as
#   <meta name="GENESIS_META_NAME" content="GENESIS_META_CONTENT">
GENESIS_META_NAME=
GENESIS_META_CONTENT=
